{
  "name": "vlc-drive-watch-party",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "package:windows": "node scripts/package-windows.mjs",
    "test:installer": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts\\test-installer.ps1"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "google-auth-library": "^10.5.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ffmpeg-static": "^5.3.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
