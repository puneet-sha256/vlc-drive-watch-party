# Create a Google OAuth client of type Desktop app, not Web application.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_API_KEY=
GOOGLE_APP_ID=
COMPANION_PORT=43821
SYNC_PORT=43822
# Guests leave empty. Hosts set their Dev Tunnel HTTPS origin for remote guests, or leave empty for local-only parties.
PUBLIC_SYNC_URL=
# Optional override; installed Windows VLC is detected automatically.
VLC_PATH=
